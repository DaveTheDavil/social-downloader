<Window x:Class="SocialDownloader.Views.AdInterstitial"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:SocialDownloader.Models"
        mc:Ignorable="d"
        Title="Reklama przed pobraniem"
        Width="500"
        Height="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/Logo/app.ico"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Body}"
        FontSize="13">
    <Window.DataContext>
        <models:AdUnit />
    </Window.DataContext>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ŻÓŁTY kontrakt banera — stały we wszystkich motywach -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Ad.BannerBorder}" BorderThickness="2"
                CornerRadius="8" Background="{DynamicResource Brush.Ad.BannerBackground}">
            <StackPanel Margin="20" VerticalAlignment="Center">
                <TextBlock Text="WIADOMOŚĆ OD NASZEGO REKLAMODAWCY:" Style="{DynamicResource SubHeading}"
                           Margin="0,0,0,12" Opacity="0.9"/>
                <Image Source="{Binding Image, FallbackValue=''}" Width="160" Height="120" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding Title, FallbackValue='Reklama'}" FontSize="18" TextWrapping="Wrap"
                           Margin="0,0,0,8" FontFamily="{DynamicResource Font.BodySemiBold}"
                           Foreground="{DynamicResource Brush.Ad.BannerText}"/>
                <TextBlock Text="{Binding Description, FallbackValue=''}" FontSize="14" TextWrapping="Wrap"
                           Margin="0,0,0,16" Foreground="{DynamicResource Brush.Ad.BannerText}" Opacity="0.9"/>
                <TextBlock Text="{Binding Advertiser, FallbackValue=''}" FontSize="12"
                           Foreground="{DynamicResource Brush.Ad.BannerText}" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="Ten ekran znika po wykupieniu wersji premium." FontSize="11"
                   Foreground="{DynamicResource Brush.TextMuted}" Margin="0,12,0,0"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Przejdź do reklamodawcy" Width="180" Margin="0,0,12,0"
                    Style="{DynamicResource PrimaryButton}"
                    Click="GoToAdvertiser_Click"/>
            <Button x:Name="SkipButton" Content="Pomiń (5s)" Width="110" IsEnabled="False"
                    Style="{DynamicResource GhostButton}"
                    Click="Skip_Click"/>
        </StackPanel>
    </Grid>
</Window>
