<Window x:Class="SocialDownloader.Views.AdInterstitial"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:SocialDownloader.Models"
        mc:Ignorable="d"
        Title="Reklama przed pobraniem"
        Width="500"
        Height="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.DataContext>
        <models:AdUnit />
    </Window.DataContext>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#FFD700" BorderThickness="2" CornerRadius="8" Background="#FFFDF5">
            <StackPanel Margin="20" VerticalAlignment="Center">
                <TextBlock Text="Wiadomość od naszego reklamodawcy:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                <Image Source="{Binding Image, FallbackValue=''}" Width="160" Height="120" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding Title, FallbackValue='Reklama'}" FontWeight="Bold" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Description, FallbackValue=''}" FontSize="14" Foreground="#444" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <TextBlock Text="{Binding Advertiser, FallbackValue=''}" FontSize="12" Foreground="#666"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="Ten ekran znika po wykupieniu wersji premium." FontSize="11" Foreground="#888" Margin="0,12,0,0"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Przejdź do reklamodawcy" Width="160" Margin="0,0,12,0"
                    Click="GoToAdvertiser_Click"/>
            <Button x:Name="SkipButton" Content="Pomiń (5s)" Width="100" IsEnabled="False"
                    Click="Skip_Click"/>
        </StackPanel>
    </Grid>
</Window>
