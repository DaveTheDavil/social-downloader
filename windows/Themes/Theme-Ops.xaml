<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         MOTYW #6 OPS COMPACT — PREMIUM ONLY (mono + czerwona purpura)
         grafit #0a0a0a / karta #101010 / czerwień #e2172c, nagłówki czerwone
         ═══════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="Brush.Window.Background" Color="#FF0A0A0A"/>
    <SolidColorBrush x:Key="Brush.Panel.Background" Color="#FF101010"/>
    <SolidColorBrush x:Key="Brush.Panel.Border" Color="#FF2A2A2A"/>

    <SolidColorBrush x:Key="Brush.Input.Background" Color="#FF060606"/>
    <SolidColorBrush x:Key="Brush.Input.Border" Color="#FF383838"/>

    <SolidColorBrush x:Key="Brush.Text" Color="#FFD6D6D6"/>
    <SolidColorBrush x:Key="Brush.TextDim" Color="#FF8C8C8C"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#FF5E5E5E"/>

    <SolidColorBrush x:Key="Brush.Heading" Color="#FFFF3B4E"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#FFE2172C"/>
    <SolidColorBrush x:Key="Brush.AccentBright" Color="#FFFF2540"/>
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Button.Hover" Color="#FF191919"/>

    <SolidColorBrush x:Key="Brush.Error" Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="Brush.Ok" Color="#FF35D07F"/>
    <SolidColorBrush x:Key="Brush.Warn" Color="#FFFFA85C"/>

    <!-- Baner reklamowy: ŻÓŁTY kontrakt — stały we wszystkich motywach -->
    <SolidColorBrush x:Key="Brush.Ad.BannerBackground" Color="#FFFFF9E6"/>
    <SolidColorBrush x:Key="Brush.Ad.BannerBorder" Color="#FFFFD700"/>
    <SolidColorBrush x:Key="Brush.Ad.BannerText" Color="#FF26200E"/>

    <SolidColorBrush x:Key="Brush.List.Selection" Color="#FF2C1418"/>

    <SolidColorBrush x:Key="Brush.StatusBar.Background" Color="#FF060606"/>
    <SolidColorBrush x:Key="Brush.StatusBar.Border" Color="#FF2A2A2A"/>

</ResourceDictionary>
