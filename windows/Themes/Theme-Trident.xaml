<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         MOTYW #2 TRIDENT — główny (ciemny, paleta 1:1 ze skórki portalu)
         czerń #000 / karta #141414 / linia #262626 / czerwień #e2172c
         ═══════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="Brush.Window.Background" Color="#FF000000"/>
    <SolidColorBrush x:Key="Brush.Panel.Background" Color="#FF141414"/>
    <SolidColorBrush x:Key="Brush.Panel.Border" Color="#FF262626"/>

    <SolidColorBrush x:Key="Brush.Input.Background" Color="#FF0D0D0D"/>
    <SolidColorBrush x:Key="Brush.Input.Border" Color="#FF303030"/>

    <SolidColorBrush x:Key="Brush.Text" Color="#FFEAEAEC"/>
    <SolidColorBrush x:Key="Brush.TextDim" Color="#FFA09A94"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#FF726C66"/>

    <SolidColorBrush x:Key="Brush.Heading" Color="#FFF2F0EC"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#FFE2172C"/>
    <SolidColorBrush x:Key="Brush.AccentBright" Color="#FFFF3B4E"/>
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Button.Hover" Color="#FF1D1D1D"/>

    <SolidColorBrush x:Key="Brush.Error" Color="#FFFF5F6F"/>
    <SolidColorBrush x:Key="Brush.Ok" Color="#FF3DDC84"/>
    <SolidColorBrush x:Key="Brush.Warn" Color="#FFFFB86B"/>

    <!-- Baner reklamowy: ŻÓŁTY kontrakt — stały we wszystkich motywach -->
    <SolidColorBrush x:Key="Brush.Ad.BannerBackground" Color="#FFFFF9E6"/>
    <SolidColorBrush x:Key="Brush.Ad.BannerBorder" Color="#FFFFD700"/>
    <SolidColorBrush x:Key="Brush.Ad.BannerText" Color="#FF26200E"/>

    <SolidColorBrush x:Key="Brush.List.Selection" Color="#FF2A0D12"/>

    <SolidColorBrush x:Key="Brush.StatusBar.Background" Color="#FF0D0D0D"/>
    <SolidColorBrush x:Key="Brush.StatusBar.Border" Color="#FF262626"/>

</ResourceDictionary>
