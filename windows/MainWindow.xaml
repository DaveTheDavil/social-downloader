<Window x:Class="SocialDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SocialDownloader"
        xmlns:vm="clr-namespace:SocialDownloader.ViewModels"
        xmlns:models="clr-namespace:SocialDownloader.Models"
        mc:Ignorable="d"
        Title="Social Downloader"
        Width="850"
        Height="700"
        MinWidth="700"
        MinHeight="550">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Disclaimer -->
        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="11" Foreground="#666666"
                   Margin="0,0,0,8">
            <Run Text="Uwaga: "/><Run FontWeight="Bold" Text="Aplikacja służy do pobierania wyłącznie treści, na które masz prawa lub które są w domenie publicznej. "/>
            <Run Text="Użytkownik ponosi pełną odpowiedzialność za przestrzeganie regulaminów platform i praw autorskich."/>
        </TextBlock>

        <!-- Sekcja linku -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,12">
            <TextBlock Text="Wklej link do filmu lub zdjęcia (Facebook, Instagram, TikTok, YouTube):" FontWeight="SemiBold"/>
            <DockPanel Margin="0,6,0,0">
                <TextBox x:Name="UrlTextBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" DockPanel.Dock="Left" MinWidth="400"/>
                <Button Content="Analizuj" Command="{Binding AnalyzeCommand}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Width="100"/>
            </DockPanel>
        </StackPanel>

        <!-- Folder docelowy -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Folder docelowy:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" MinWidth="300" VerticalAlignment="Center"/>
            <Button Content="Wybierz folder" Click="ChooseFolder_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Width="110"/>
        </StackPanel>

        <!-- Wynik analizy -->
        <Border Grid.Row="3" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12" Background="#F9F9F9">
            <StackPanel>
                <TextBlock Text="Wynik analizy" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding VideoInfo.Title, FallbackValue='--', TargetNullValue='--'}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Czas: " Foreground="#666"/>
                        <TextBlock Text="{Binding VideoInfo.Duration, StringFormat={}{0} s, FallbackValue='--'}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                        <TextBlock Text="Autor: " Foreground="#666"/>
                        <TextBlock Text="{Binding VideoInfo.Uploader, FallbackValue='--'}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                        <TextBlock Text="Premium: " Foreground="#666"/>
                        <TextBlock Text="{Binding PremiumLabel}" Foreground="{Binding IsPremium, Converter={x:Static local:BooleanToColorConverter.Instance}}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Wybór jakości -->
        <StackPanel Grid.Row="4" Orientation="Vertical" Margin="0,0,0,12">
            <TextBlock Text="Wybierz jakość:" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding Qualities, FallbackValue={x:Null}}" SelectedItem="{Binding SelectedQuality, Mode=TwoWay}" MinWidth="120"/>
            <TextBlock Text="{Binding Qualities.Count, StringFormat='Dostępne rozdzielczości: {0} (p)', FallbackValue='Dostępne rozdzielczości: 0 (p)'}" Foreground="#666" FontSize="11" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding PlaylistNote, FallbackValue=''}" TextWrapping="Wrap" Foreground="#8A6D3B" FontSize="11" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Lista pozycji do pobrania (seria IG / pojedyncze wideo) -->
        <ListBox Grid.Row="5"
                 ItemsSource="{Binding Items, FallbackValue={x:Null}}"
                 MaxHeight="200"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 BorderBrush="#DDDDDD" BorderThickness="1" Padding="4"
                 Margin="0,0,0,12"
                 Visibility="{Binding HasItems, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Label}" Margin="6,3,0,3" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Przycisk pobierania i postęp -->
        <StackPanel Grid.Row="6" Orientation="Vertical" Margin="0,0,0,12">
            <Button Content="{Binding DownloadButtonText, FallbackValue='Pobierz plik'}" Command="{Binding DownloadCommand}" Style="{StaticResource PrimaryButton}" Height="40"/>
            <ProgressBar Value="{Binding Progress}" Height="8" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Baner reklamowy (darmowa wersja) -->
        <Border x:Name="AdBannerBorder" Grid.Row="7" Visibility="{Binding ShowAds, Converter={x:Static local:BooleanToVisibilityConverter.Instance}}"
                BorderBrush="#FFD700" BorderThickness="1" CornerRadius="4" Padding="8" Background="#FFF9E6" Margin="0,0,0,8">
            <DockPanel>
                <Image Source="{Binding BannerAd.Image, FallbackValue=''}" Width="64" Height="64" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Vertical" HorizontalAlignment="Right">
                    <Button Content="X" Width="24" Height="24" Background="Transparent" BorderThickness="0" Click="CloseBanner_Click"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding BannerAd.Title, FallbackValue='Reklama'}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding BannerAd.Advertiser, FallbackValue=''}" FontSize="11" Foreground="#666"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Sesja Instagram (panel ustawień MVP): paste cookie → pełne serie zdjęć.
             Zawsze widoczny — można podmienić/wyczyścić cookie; label pokazuje stan. -->
        <Border Grid.Row="8" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="8"
                Margin="0,0,0,8" Background="#FAFAFA">
            <StackPanel>
                <TextBlock Text="Sesja Instagram (pełne serie zdjęć):" FontWeight="SemiBold" FontSize="12"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding IgCookieInput, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                             ToolTip="Wklej cookie z przeglądarki (App devtools → Application → Cookies → www.instagram.com) — minimum: sessionid=...; ds_user_id=..."/>
                    <Button Grid.Column="1" Content="Zapisz sesję" Command="{Binding SaveIgCookieCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinWidth="110"/>
                </Grid>
                <TextBlock Text="{Binding IgSessionLabel, FallbackValue='Sesja IG: nie ustawiona'}"
                           FontSize="11" Foreground="#8A6D3B" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Licencja premium (ukryta, gdy licencja jest już aktywna) -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,8,0,0"
                    Visibility="{Binding IsPremium, Converter={x:Static local:BooleanToVisibilityInverseConverter.Instance}}">
            <Button Content="Aktywuj wersję premium (test)" Command="{Binding ActivateLicenseCommand}" Style="{StaticResource PrimaryButton}"/>
            <TextBlock Text="Własny klucz licencyjny: " Foreground="#666" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBox x:Name="LicenseKeyBox" Width="200" Margin="4,0,0,0"/>
        </StackPanel>

        <StatusBar Grid.Row="10">
            <StatusBarItem>
                <TextBlock Text="{Binding Status, FallbackValue='Gotowy'}" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
